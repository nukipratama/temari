{
  "permissions": {
    "allow": [
      "Bash(./vendor/bin/sail bin pest)",
      "Bash(./vendor/bin/sail bin pest *)",
      "Bash(./vendor/bin/sail pest)",
      "Bash(./vendor/bin/sail pest *)",
      "Bash(./vendor/bin/sail bin phpstan)",
      "Bash(./vendor/bin/sail bin phpstan *)",
      "Bash(./vendor/bin/sail composer gate)",
      "Bash(./vendor/bin/sail composer gate *)",
      "Bash(./vendor/bin/sail npm run test)",
      "Bash(./vendor/bin/sail npm run typecheck)",
      "Bash(./vendor/bin/sail npm run lint)",
      "Bash(./vendor/bin/sail npx tsc *)",
      "Bash(./vendor/bin/sail artisan route:list)",
      "Bash(./vendor/bin/sail artisan route:list *)",
      "Bash(./vendor/bin/sail artisan list)",
      "Bash(gh issue list)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr view)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff)",
      "Bash(gh pr diff *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh project view *)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh project item-edit *)"
    ],
    "deny": [
      "Bash(docker volume rm *)"
    ]
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/worktree-hook-create.sh"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "scripts/worktree-hook-remove.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
