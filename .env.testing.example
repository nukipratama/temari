# Loaded by Laravel instead of .env whenever APP_ENV=testing (phpunit.xml
# sets this). Copy to .env.testing on a plain checkout; scripts/worktree-setup.sh
# does this automatically and rewrites the values below to point at the
# shared test services with a slot-specific schema.
DB_HOST=mysql_test
DB_DATABASE=temari_testing
DB_ANALYTICS_DATABASE=temari_testing
REDIS_HOST=redis_test
# Redis DB slot base: 0 on a plain checkout; scripts/worktree sets slot*32 (slots 1-3).
REDIS_DB=0
# Empty fails every Strava webhook delivery closed; tests set their own via config().
STRAVA_WEBHOOK_CALLBACK_TOKEN=
