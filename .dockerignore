!bootstrap/
# Locally-generated, dev-context manifests (list dev-only providers like
# laravel/boost) — must NOT leak into the prod image or package:discover fails
# loading a class absent from the --no-dev vendor. Regenerated in the image.
bootstrap/cache/*
!bootstrap/cache/.gitignore

!database/
database/factories

!public/
public/build
public/hot
public/storage
public/fonts-manifest.dev.json

!resources/

!storage/
storage/**
!storage/**/.gitignore

!.npmrc
!package.json
!package-lock.json
!vite.config.ts
!tsconfig.json

!docker/Caddyfile
!docker/Caddyfile.dev
!docker/php.ini
!docker/php.dev.ini
!docker/imagemagick-policy.xml
