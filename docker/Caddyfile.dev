# Dev Caddyfile — FrankenPHP traditional mode (no Octane worker).
# PHP runs per-request so file changes are picked up automatically
# without restarting the container.
{
	auto_https off
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

:80 {
	root * /var/www/html/public
	encode gzip

	@vite path /build/*
	handle @vite {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	@static path /favicon.ico /favicon.svg /robots.txt /apple-touch-icon.png
	handle @static {
		file_server
	}

	# Service worker: never long-cache it, or an updated sw.js serves stale and the
	# push handler never refreshes.
	@sw path /sw.js
	handle @sw {
		header Cache-Control "no-cache"
		header Content-Type "text/javascript"
		file_server
	}

	# Web app manifest: Caddy has no .webmanifest MIME entry, so set it explicitly.
	@manifest path /manifest.webmanifest
	handle @manifest {
		header Content-Type "application/manifest+json"
		file_server
	}

	handle {
		header -Server
		php_server
	}
}
