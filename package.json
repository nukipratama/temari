{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=24 <25"
    },
    "scripts": {
        "build": "vite build",
        "dev": "vite",
        "purge": "rm -rf public/build public/hot node_modules/.vite node_modules/.cache coverage",
        "lint": "eslint resources/js --max-warnings 0",
        "format": "prettier --write resources/js",
        "format:check": "prettier --check resources/js",
        "check:chunks": "node scripts/check-entry-chunks.mjs",
        "check:palette": "node scripts/check-raw-palette.mjs",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc"
    },
    "devDependencies": {
        "@eslint-react/eslint-plugin": "^5.24.8",
        "@tailwindcss/vite": "^4.0.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/leaflet": "^1.9.22",
        "@types/mapbox__polyline": "^1.0.5",
        "@types/node": "^25.9.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.3",
        "concurrently": "^10.0.5",
        "eslint": "^10.12.0",
        "eslint-plugin-perfectionist": "^5.12.1",
        "eslint-plugin-react-hooks": "^7.1.1",
        "jsdom": "^30.1.2",
        "laravel-vite-plugin": "^3.2",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.0.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.1",
        "vite": "^8.3.3",
        "vitest": "^5.0.3",
        "vitest-canvas-mock": "1.2.0"
    },
    "dependencies": {
        "@base-ui/react": "^1.8.0",
        "@fontsource-variable/fraunces": "5.3.0",
        "@fontsource-variable/jetbrains-mono": "5.3.0",
        "@fontsource-variable/plus-jakarta-sans": "5.3.0",
        "@inertiajs/react": "^3.8.0",
        "@mapbox/polyline": "^1.2.1",
        "chart.js": "^4.5.1",
        "class-variance-authority": "0.7.1",
        "leaflet": "^1.9.4",
        "lucide-react": "^1.52.0",
        "react": "^19.3.0",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.3.0",
        "react-leaflet": "^5.0.0",
        "tailwind-merge": "^3.7.0"
    },
    "overrides": {
        "shell-quote": "^1.11.0"
    }
}
