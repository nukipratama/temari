includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

services:
    -
        class: Tests\PHPStan\PestClosureThisExtension
        tags:
            - phpstan.functionParameterClosureThisExtension
            - phpstan.methodParameterClosureThisExtension
    -
        class: Tests\PHPStan\PestTestFunctionReturnTypeExtension
        tags:
            - phpstan.broker.dynamicFunctionReturnTypeExtension
    -
        class: Tests\PHPStan\ArtisanReturnTypeExtension
        tags:
            - phpstan.broker.dynamicMethodReturnTypeExtension

parameters:
    level: 9
    paths:
        - app/
        - database/
        - tests/Pest.php
        - tests/Feature/Auth
        - tests/Unit/Listeners
        - tests/Unit/Notifications
        - tests/Unit/Services/AI
        - tests/Unit/Services/Devtools
        - tests/Unit/Services/Gamification
        - tests/Unit/Services/IntervalsIcu
        - tests/Unit/Services/Notifications
        - tests/Unit/Services/Ops
        - tests/Unit/Services/Run/Ingest
        - tests/Unit/Services/Run/Story
        - tests/Unit/Services/Run/Trend
        - tests/Unit/Services/Run/FeedQueryTest.php
        - tests/Unit/Services/Run/LifetimeStatsTest.php
        - tests/Unit/Services/Run/PostRunNoteReaderTest.php
        - tests/Unit/Services/Run/ProgressionSeriesBuilderTest.php
        - tests/Unit/Services/Strava
        - tests/Unit/Services/Telegram
        - tests/Unit/Services/User
        - tests/Unit/Services/Weather
    tmpDir: .phpstan-cache

    # Sail's memory_limit=-1 lets workers grow until OOM-killer hits; cap them.
    parallel:
        maximumNumberOfProcesses: 2
