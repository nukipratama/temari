#!/usr/bin/env bash
set -euo pipefail

CURRENT_BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
if [ "$CURRENT_BRANCH" = "main" ]; then
  cat >&2 <<EOF
pre-commit: direct commits to 'main' are blocked.

  → Create a feature branch:   git switch -c feat/your-change
  → Push it:                   git push -u origin feat/your-change
  → Open a PR + let CI run:    gh pr create --fill
  → Merge via the GitHub UI once green.
EOF
  exit 1
fi

# --- Secret scan (gitleaks): block staged credential leaks before they ever
# enter history. Runs on ALL staged files — before the PHP/TS early-exit below —
# since a secret can hide in a .env, .json, .yml or .md just as easily.
if [ "${SKIP_GITLEAKS:-0}" != "1" ]; then
  if command -v gitleaks >/dev/null 2>&1; then
    if ! gitleaks git --staged --redact --no-banner; then
      cat >&2 <<'EOF'

pre-commit: gitleaks flagged a possible secret in your staged changes (see above).

  → Real credential?  Remove it from the diff AND rotate it (assume it's burned).
  → False positive?   Add an allowlist entry to .gitleaks.toml.
EOF
      exit 1
    fi
  else
    cat >&2 <<'EOF'
pre-commit: gitleaks is not installed — the secret scan cannot run.

  → Install:  brew install gitleaks   (https://github.com/gitleaks/gitleaks)
EOF
    exit 1
  fi
fi

STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.php$' || true)
STAGED_TS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(ts|tsx)$' || true)

[ -z "$STAGED_PHP" ] && [ -z "$STAGED_TS" ] && exit 0

if ! docker compose ps --status running --services 2>/dev/null | grep -qx 'app'; then
  echo "pre-commit: sail not running — run './vendor/bin/sail up -d'" >&2
  exit 1
fi

# Formatting + the static analysis that is cheap enough to pay for on every
# commit. `composer check` is the full gate and runs before a push; rector and
# tsc moved there, being the two slowest steps here and fully covered by it.
#
# Each language branch is ONE `sail exec`. The container round-trip costs ~1.1s,
# which was the largest single line item in the old hook's three-call shape.
#
# phpstan stays FULL rather than staged-scoped, which is faster, not slower:
# measured 1.5s warm across the tree against 5.0s for a single file, because a
# scoped run cannot reuse the whole-project result cache. eslint stays full too
# — scoping it once let two lint errors reach main, and it costs 3.4s.
#
# pint and prettier rewrite staged files in place; that is the point of them,
# and they only ever touch files the commit already contains.
run_checks() {
  local status=0
  ./vendor/bin/sail exec -T app sh -c "$1" || status=$?
  # Re-stage whatever the formatter rewrote, pass or fail, so a later failure
  # never throws away the formatting this run already did.
  # shellcheck disable=SC2086
  git add $2
  return $status
}

if [ -n "$STAGED_PHP" ]; then
  if ! run_checks "./vendor/bin/pint $(echo $STAGED_PHP | tr '\n' ' ') && ./vendor/bin/phpstan analyse --no-progress" "$STAGED_PHP"; then
    echo "pre-commit: pint/phpstan failed above. Fix it, then re-commit." >&2
    exit 1
  fi
fi

if [ -n "$STAGED_TS" ]; then
  if ! run_checks "npx prettier --write $(echo $STAGED_TS | tr '\n' ' ') && npm run lint" "$STAGED_TS"; then
    echo "pre-commit: prettier/eslint failed above. Fix it, then re-commit." >&2
    exit 1
  fi
fi
