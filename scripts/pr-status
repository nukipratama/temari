#!/usr/bin/env bash
# One line per open PR (or the given PR numbers): checks, merge state, auto-merge,
# and the board column of the issue it closes.
set -euo pipefail

prs=$(gh pr list --state open --limit 100 \
  --json number,title,mergeStateStatus,autoMergeRequest,statusCheckRollup,closingIssuesReferences \
  | jq --arg wanted "$*" '
    ($wanted | split(" ") | map(select(. != ""))) as $only
    | map(select(($only | length) == 0 or ((.number | tostring) as $n | $only | index($n))))')

issues=$(jq -r '[.[].closingIssuesReferences[].number] | unique | .[]' <<<"$prs")

columns='{}'
if [ -n "$issues" ]; then
  fields=""
  for n in $issues; do
    fields+="i${n}: issue(number: ${n}) { ...card } "
  done
  columns=$(gh api graphql -f query="
    query { repository(owner: \"nukipratama\", name: \"temari\") { ${fields} } }
    fragment card on Issue {
      projectItems(first: 10) { nodes { project { number } fieldValueByName(name: \"Status\") { ... on ProjectV2ItemFieldSingleSelectValue { name } } } }
    }" --jq '.data.repository | with_entries(.key |= ltrimstr("i") | .value |= (first(.projectItems.nodes[] | select(.project.number == 1) | .fieldValueByName.name // "-") // "off-board"))')
fi

jq -r --argjson columns "$columns" '
  .[]
  | ([.statusCheckRollup[] | {name: (.name // .context), state: (.conclusion // .state // .status)}]) as $checks
  | ([$checks[] | select(.state | IN("FAILURE", "CANCELLED", "TIMED_OUT", "ERROR", "ACTION_REQUIRED")) | .name]) as $failed
  | (if ($failed | length) > 0 then "FAIL(" + ($failed | join(",")) + ")"
     elif any($checks[]; .state | IN("SUCCESS", "SKIPPED", "NEUTRAL") | not) then "pending"
     elif ($checks | length) == 0 then "no-checks"
     else "pass" end) as $ci
  | ([.closingIssuesReferences[].number | tostring | "#" + . + "=" + ($columns[.] // "off-board")] | join(" ")) as $cards
  | "#\(.number)\t\($ci)\t\(.mergeStateStatus)\tauto-merge=\(if .autoMergeRequest then "on" else "off" end)\t\(if $cards == "" then "no-closing-issue" else $cards end)\t\(.title[0:60])"
' <<<"$prs"
